### Server Action (pola wajib):
```typescript
'use server'
import { createClient } from '@/lib/supabase/server'
import { logAudit } from '@/lib/audit/log'

export async function createData(data: CreateInput) {
  const supabase = await createClient()
  const { data: { user } } = await supabase.auth.getUser()
  if (!user) throw new Error('Tidak terautentikasi')

  const { data: result, error } = await supabase
    .from('table_name')
    .insert(data)
    .select()
    .single()

  if (error) throw new Error(error.message)

  await logAudit(user.id, 'CREATE', 'table_name', result.id, null, result)
  return result
}
```

### React Query (pola wajib):
```typescript
'use client'
const { data, isLoading, error } = useQuery({
  queryKey: ['key', param1, param2],
  queryFn: () => getData(param1, param2),
})

const mutation = useMutation({
  mutationFn: createData,
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ['key'] })
    toast({ title: 'Berhasil', description: 'Data berhasil disimpan' })
  },
  onError: (error: Error) => {
    toast({ title: 'Gagal', description: error.message, variant: 'destructive' })
  }
})
```

### Supabase Query dengan Filter Unit/Status:
```typescript
// Filter siswa aktif saja (SELALU kecuali halaman Alumni):
.eq('is_alumni', false)

// Filter hanya data yang sudah diproses (SELALU untuk perhitungan poin):
.eq('status', 'Sudah Diproses')

// Filter nilai yang sudah diapprove (SELALU untuk orang_tua):
.eq('is_approved', true)
```

